[Unit]
Description=Palworld Panel Background Updater (manual)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=demo
Group=demo
WorkingDirectory=/home/demo/palworld-panel
# The leading "-" keeps the unit startable when the env file is missing.
EnvironmentFile=-/etc/palworld-panel.env
ExecStart=/usr/bin/python3 /home/demo/palworld-panel/panel_update.py --apply
# 3 SteamCMD attempts x 30 min + player countdown + backups.
TimeoutStartSec=7200
TimeoutStopSec=120
KillMode=mixed
Nice=5
